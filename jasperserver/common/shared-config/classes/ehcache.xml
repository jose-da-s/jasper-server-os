<config
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns='http://www.ehcache.org/v3'
        xmlns:jcache="http://www.ehcache.org/v3/jsr107"
        xsi:schemaLocation="http://www.ehcache.org/v3 http://www.ehcache.org/schema/ehcache-core-3.0.xsd
        					http://www.ehcache.org/v3/jsr107 http://www.ehcache.org/schema/ehcache-107-ext-3.0.xsd">

	<service>
		<jcache:defaults default-template="defaultCacheTemplate" enable-management="true" enable-statistics="true"/>
	</service>

    <persistence directory="${ehcache.disk.store.dir}/main"/>

	<cache-template name="defaultCacheTemplate">
		<expiry>
            <ttl unit="seconds">120</ttl>
		</expiry>
		<heap unit="entries">10000</heap>
	</cache-template>

	<cache alias="report.job.acl">
		<expiry>
            <ttl unit="seconds">86400</ttl>
		</expiry>
		<heap unit="entries">1000</heap>
	</cache>

	<cache alias="connection.descriptions">
		<expiry>
            <ttl unit="seconds">1200</ttl>
		</expiry>
		<heap unit="entries">10000</heap>
	</cache>

	<cache alias="hibernate_repository_ehcache">
		<expiry>
            <ttl unit="seconds">1200</ttl>
		</expiry>
		<resources>
		    <heap unit="entries">500</heap>
            <disk persistent="false" unit="MB">10</disk>
		</resources>
	</cache>

	<cache alias="RRSCache">
		<expiry>
            <ttl unit="seconds">1200</ttl>
		</expiry>
		<heap unit="entries">500</heap>
	</cache>

	<cache alias="attributeCache">
		<expiry>
            <ttl unit="days">5</ttl>
		</expiry>
		<heap unit="entries">500</heap>
	</cache>

	<cache alias="inputControlCache">
		<expiry>
            <ttl unit="days">5</ttl>
		</expiry>
		<heap unit="entries">10000</heap>
	</cache>

	<cache alias="teiidResultsetEhCache">
		<expiry>
            <ttl unit="days">5</ttl>
		</expiry>
		<heap unit="entries">10000</heap>
	</cache>

	<cache alias="teiidResultsetReplEhCache">
		<expiry>
            <ttl unit="days">5</ttl>
		</expiry>
		<heap unit="entries">10000</heap>
	</cache>

	<cache alias="teiidPreparedPlanEhCache">
		<expiry>
            <ttl unit="days">5</ttl>
		</expiry>
		<heap unit="entries">10000</heap>
	</cache>

	<cache alias="systemUserStorageCache">
		<expiry>
            <ttl unit="days">5</ttl>
		</expiry>
		<heap unit="entries">10000</heap>
	</cache>

    <!-- Caches related to dashboard executions and exports.
    They all should have exactly the same settings: maxElementsInMemory, timeToIdleSeconds, timeToLiveSeconds
    and others -->

	<cache alias="dashboardTasks">
		<expiry>
            <ttl unit="seconds">3600</ttl>
		</expiry>
		<heap unit="entries">1000</heap>
	</cache>

	<cache alias="dashboardResults">
		<expiry>
            <ttl unit="seconds">3600</ttl>
		</expiry>
		<heap unit="entries">1000</heap>
	</cache>

	<cache alias="dashboardProcesses">
		<expiry>
            <ttl unit="seconds">3600</ttl>
		</expiry>
		<heap unit="entries">1000</heap>
	</cache>

	<cache alias="dashboardIDToUsers">
		<expiry>
            <ttl unit="seconds">3600</ttl>
		</expiry>
		<heap unit="entries">1000</heap>
	</cache>

 <!-- =============================================
       cache used by the object permission service
      ============================================= -->

	<cache alias="aclCache">
		<expiry>
            <ttl unit="seconds">36000</ttl>
		</expiry>
		<heap unit="entries">100000</heap>
	</cache>

</config>
