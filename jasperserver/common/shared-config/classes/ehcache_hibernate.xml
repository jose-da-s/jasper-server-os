<config
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns='http://www.ehcache.org/v3'
        xmlns:jcache="http://www.ehcache.org/v3/jsr107"
        xsi:schemaLocation="http://www.ehcache.org/v3 http://www.ehcache.org/schema/ehcache-core-3.0.xsd
        					http://www.ehcache.org/v3/jsr107 http://www.ehcache.org/schema/ehcache-107-ext-3.0.xsd">

	<service>
		<jcache:defaults default-template="defaultCacheTemplate" enable-management="true" enable-statistics="true">
			<jcache:cache name="defaultRepoCache" template="defaultRepoCacheTemplate"/>
			<jcache:cache name="roles" template="rolesCacheTemplate"/>
			<jcache:cache name="rolesByTenant" template="rolesByTenantCacheTemplate"/>
			<jcache:cache name="users" template="usersCacheTemplate"/>
			<jcache:cache name="usersByTenant" template="usersByTenantCacheTemplate"/>
			<jcache:cache name="tenants" template="tenantsCacheTemplate"/>
			<jcache:cache name="tenantsByName" template="tenantsByNameCacheTemplate"/>
			<jcache:cache name="folders" template="foldersCacheTemplate"/>
			<jcache:cache name="profileAttributes" template="profileAttributesCacheTemplate"/>
		</jcache:defaults>
	</service>

    <persistence directory="${ehcache.disk.store.dir}/hibernate"/>

	<cache-template name="defaultCacheTemplate">
		<expiry>
            <ttl unit="seconds">10800</ttl>
		</expiry>
		<heap unit="entries">10000</heap>
	</cache-template>

	<cache-template name="defaultRepoCacheTemplate">
		<expiry>
            <ttl unit="days">2</ttl>
		</expiry>
		<heap unit="entries">10000</heap>
	</cache-template>

	<cache-template name="rolesCacheTemplate">
		<expiry>
            <none/>
		</expiry>
		<heap unit="entries">1000</heap>
	</cache-template>

	<cache-template name="rolesByTenantCacheTemplate">
		<expiry>
            <none/>
		</expiry>
		<heap unit="entries">1000</heap>
	</cache-template>

	<cache-template name="usersCacheTemplate">
		<expiry>
            <none/>
		</expiry>
		<heap unit="entries">10000</heap>
	</cache-template>

	<cache-template name="usersByTenantCacheTemplate">
		<expiry>
            <none/>
		</expiry>
		<heap unit="entries">10000</heap>
	</cache-template>

	<cache-template name="tenantsCacheTemplate">
		<expiry>
            <none/>
		</expiry>
		<heap unit="entries">1000</heap>
	</cache-template>

	<cache-template name="tenantsByNameCacheTemplate">
		<expiry>
            <none/>
		</expiry>
		<heap unit="entries">1000</heap>
	</cache-template>

	<cache-template name="foldersCacheTemplate">
		<expiry>
            <none/>
		</expiry>
		<heap unit="entries">100000</heap>
	</cache-template>

	<cache-template name="profileAttributesCacheTemplate">
		<expiry>
            <none/>
		</expiry>
		<heap unit="entries">100000</heap>
	</cache-template>

</config>

