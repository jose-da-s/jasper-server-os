<?xml version="1.0" encoding="UTF-8"?>
<!-- Created with Jaspersoft Studio -->
<jasperTemplate xmlns="http://jasperreports.sourceforge.net/jasperreports/template" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports/template http://jasperreports.sourceforge.net/xsd/jaspertemplate.xsd">
	<style name="defaultStyle" isDefault="true" isBlankWhenNull="true" fontName="DejaVu Serif Condensed" fontSize="10"/>
	<style name="textLabel" style="defaultStyle" isBold="true"/>
	<style name="textValue" style="textLabel" isBold="false"/>
	<style name="listHeader" style="defaultStyle" isBold="true"/>
	<style name="listCell" style="listHeader" isBold="false">
		<box topPadding="2" bottomPadding="2"/>
	</style>
	<style name="title1" style="defaultStyle" isBold="true"/>
	<style name="title2" style="title1"/>
	<style name="title3" style="title2"/>
	<style name="sumLabel" style="textLabel" isBold="true">
		<box topPadding="2" bottomPadding="2"/>
	</style>
	<style name="sumValue" style="textValue" isBold="false">
		<box topPadding="2" bottomPadding="2"/>
	</style>
	<style name="footer" style="defaultStyle" vTextAlign="Bottom"/>
	<style name="line" style="defaultStyle" vTextAlign="Bottom">
		<box>
			<topPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
			<leftPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
			<bottomPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
			<rightPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
		</box>
	</style>
	<style name="sumLine" style="defaultStyle" vTextAlign="Bottom">
		<box>
			<topPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
			<leftPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
			<bottomPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
			<rightPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
		</box>
	</style>
	<style name="prefilled" style="defaultStyle" isBold="true"/>
	<style name="title1Underlined" style="title1" isBold="true" isUnderline="true"/>
	<style name="title2Underlined" style="title2" isBold="true" isUnderline="true"/>
	<style name="inputUnderline" style="defaultStyle" vTextAlign="Bottom">
		<box>
			<topPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
			<leftPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
			<bottomPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
			<rightPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
		</box>
	</style>
	<style name="inputUnderlineDashed" style="defaultStyle" vTextAlign="Bottom">
		<pen lineStyle="Dashed"/>
		<box>
			<topPen lineWidth="1.0" lineStyle="Dashed" lineColor="#000000"/>
			<leftPen lineWidth="1.0" lineStyle="Dashed" lineColor="#000000"/>
			<bottomPen lineWidth="1.0" lineStyle="Dashed" lineColor="#000000"/>
			<rightPen lineWidth="1.0" lineStyle="Dashed" lineColor="#000000"/>
		</box>
	</style>
	<style name="signatureLabelBelow" style="defaultStyle">
		<box topPadding="4"/>
	</style>
	<style name="checkbox" style="defaultStyle" vTextAlign="Bottom">
		<box>
			<pen lineWidth="0.5"/>
		</box>
	</style>
	<style name="inputTableHeader" style="listHeader" hTextAlign="Center" vTextAlign="Middle">
		<box>
			<pen lineWidth="1.5"/>
		</box>
	</style>
	<style name="inputTableCell" style="listCell" vTextAlign="Bottom">
		<box>
			<pen lineWidth="1.0"/>
		</box>
	</style>
	<style name="greyBackground" style="textLabel" mode="Opaque" backcolor="#E6E6E6" isBold="false"/>
	<style name="addressLabel" style="defaultStyle" fontSize="8" isBold="true"/>
	<style name="addressValue" style="textLabel" fontSize="8" isBold="false"/>
	<style name="titleLetter" style="title1" fontSize="12"/>
	<style name="textLabel_large" style="defaultStyle" fontSize="12" isBold="true"/>
	<style name="textValue_large" style="textLabel" scaleImage="FillFrame" fontSize="12" isBold="false"/>
</jasperTemplate>
