<config
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns='http://www.ehcache.org/v3'
        xmlns:jcache="http://www.ehcache.org/v3/jsr107"
        xsi:schemaLocation="http://www.ehcache.org/v3 http://www.ehcache.org/schema/ehcache-core-3.0.xsd
        					http://www.ehcache.org/v3/jsr107 http://www.ehcache.org/schema/ehcache-107-ext-3.0.xsd">

	<service>
		<jcache:defaults default-template="defaultCacheTemplate" enable-management="true" enable-statistics="true">
			<jcache:cache name="snapshotMetadataCache" template="snapshotMetadataCacheTemplate"/>
			<jcache:cache name="snapshotContentsCache" template="snapshotContentsCacheTemplate"/>
		</jcache:defaults>
	</service>

    <persistence directory="${ehcache.disk.store.dir}/dataSnapshots"/>

	<cache-template name="defaultCacheTemplate">
		<expiry>
            <ttl unit="seconds">120</ttl>
		</expiry>
		<heap unit="entries">10000</heap>
	</cache-template>

    <cache-template name="snapshotMetadataCacheTemplate">
		<expiry>
            <ttl unit="seconds">3600</ttl>
		</expiry>
		<heap unit="entries">1000</heap>
	</cache-template>

    <cache-template name="snapshotContentsCacheTemplate">
		<expiry>
            <ttl unit="seconds">3600</ttl>
		</expiry>
		<heap unit="entries">20</heap>
	</cache-template>

</config>
