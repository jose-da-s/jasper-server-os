<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd"
         xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.jaspersoft.jasperserver</groupId>
    <artifactId>jasperserver-jakarta-libs</artifactId>
    <packaging>pom</packaging>
    <name>installs jakarta-migrated versions of some old dependencies</name>
    <parent>
        <groupId>com.jaspersoft.jasperserver</groupId>
        <artifactId>server</artifactId>
        <version>${buildArtifactVersionName}</version>
    </parent>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-install-plugin</artifactId>
				<version>3.1.4</version>
				<executions>
					<execution>
						<id>btm</id>
						<phase>install</phase>
						<goals>
							<goal>install-file</goal>
						</goals>
						<configuration>
							<file>lib/btm-2.1.3-jakarta.jar</file>
							<groupId>org.codehaus.btm</groupId>
							<artifactId>btm</artifactId>
							<version>2.1.3</version>
							<classifier>jakarta</classifier>
							<packaging>jar</packaging>
						</configuration>
					</execution>
					<execution>
						<id>teiid-admin</id>
						<phase>install</phase>
						<goals>
							<goal>install-file</goal>
						</goals>
						<configuration>
							<file>lib/teiid-admin-9.1.1-jakarta.jar</file>
							<groupId>org.jboss.teiid</groupId>
							<artifactId>teiid-admin</artifactId>
							<version>9.1.1</version>
							<classifier>jakarta</classifier>
							<packaging>jar</packaging>
						</configuration>
					</execution>
					<execution>
						<id>teiid-api</id>
						<phase>install</phase>
						<goals>
							<goal>install-file</goal>
						</goals>
						<configuration>
							<file>lib/teiid-api-9.1.1-jakarta.jar</file>
							<groupId>org.jboss.teiid</groupId>
							<artifactId>teiid-api</artifactId>
							<version>9.1.1</version>
							<classifier>jakarta</classifier>
							<packaging>jar</packaging>
						</configuration>
					</execution>
					<execution>
						<id>teiid-client</id>
						<phase>install</phase>
						<goals>
							<goal>install-file</goal>
						</goals>
						<configuration>
							<file>lib/teiid-client-9.1.1-jakarta.jar</file>
							<groupId>org.jboss.teiid</groupId>
							<artifactId>teiid-client</artifactId>
							<version>9.1.1</version>
							<classifier>jakarta</classifier>
							<packaging>jar</packaging>
						</configuration>
					</execution>
					<execution>
						<id>teiid-common-core</id>
						<phase>install</phase>
						<goals>
							<goal>install-file</goal>
						</goals>
						<configuration>
							<file>lib/teiid-common-core-9.1.1-jakarta.jar</file>
							<groupId>org.jboss.teiid</groupId>
							<artifactId>teiid-common-core</artifactId>
							<version>9.1.1</version>
							<classifier>jakarta</classifier>
							<packaging>jar</packaging>
						</configuration>
					</execution>
					<execution>
						<id>teiid-engine</id>
						<phase>install</phase>
						<goals>
							<goal>install-file</goal>
						</goals>
						<configuration>
							<file>lib/teiid-engine-9.1.1-jakarta.jar</file>
							<groupId>org.jboss.teiid</groupId>
							<artifactId>teiid-engine</artifactId>
							<version>9.1.1</version>
							<classifier>jakarta</classifier>
							<packaging>jar</packaging>
						</configuration>
					</execution>
					<execution>
						<id>teiid-metadata</id>
						<phase>install</phase>
						<goals>
							<goal>install-file</goal>
						</goals>
						<configuration>
							<file>lib/teiid-metadata-9.1.1-jakarta.jar</file>
							<groupId>org.jboss.teiid</groupId>
							<artifactId>teiid-metadata</artifactId>
							<version>9.1.1</version>
							<classifier>jakarta</classifier>
							<packaging>jar</packaging>
						</configuration>
					</execution>
					<execution>
						<id>teiid-runtime</id>
						<phase>install</phase>
						<goals>
							<goal>install-file</goal>
						</goals>
						<configuration>
							<file>lib/teiid-runtime-9.1.1-jakarta.jar</file>
							<groupId>org.jboss.teiid</groupId>
							<artifactId>teiid-runtime</artifactId>
							<version>9.1.1</version>
							<classifier>jakarta</classifier>
							<packaging>jar</packaging>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>